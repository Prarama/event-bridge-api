  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Prarama/event-bridge-api/issues"
  },
  "homepage": "https://github.com/Prarama/event-bridge-api#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
