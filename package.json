{
  "name": "event-bridge-api",
  "version": "1.0.0",
  "description": "A robust RESTful API backend for a virtual event platform built with Node.js and Express. Features JWT auth, bcrypt hashing, and role-based access for Organizers and Attendees. Uses in-memory storage for event CRUD, participant tracking, and async email alerts on registration",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
